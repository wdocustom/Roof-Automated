# =============================================================================
# Roof Automated - Environment Configuration
# Copy to .env and fill in values. NEVER commit .env to version control.
# =============================================================================

# -- Database --
DATABASE_URL=postgresql+asyncpg://roof_user:password@localhost:5432/roof_automated
DATABASE_SYNC_URL=postgresql://roof_user:password@localhost:5432/roof_automated

# -- Clerk Auth --
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json

# -- Temporal --
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=roof-automated
TEMPORAL_TASK_QUEUE=roof-main
# For Temporal Cloud:
# TEMPORAL_HOST=your-namespace.tmprl.cloud:7233
# TEMPORAL_TLS_CERT_PATH=/path/to/cert.pem
# TEMPORAL_TLS_KEY_PATH=/path/to/key.pem

# -- Twilio --
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
TWILIO_MESSAGING_SERVICE_SID=MG...
TWILIO_WEBHOOK_SECRET=...

# -- Stripe --
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# -- LLM Providers --
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# -- LangSmith Observability --
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=lsv2_...
LANGCHAIN_PROJECT=roof-automated

# -- AWS S3 (Media Storage) --
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
AWS_S3_BUCKET=roof-automated-media
AWS_REGION=us-east-1

# -- App Config --
ENVIRONMENT=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:3000"]
